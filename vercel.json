{
  "version": 2,
  "builds": [
    {
      "src": "v1/package.json",
      "use": "@vercel/next",
      "config": { "distDir": ".next" }
    },
    {
      "src": "v2/package.json",
      "use": "@vercel/next",
      "config": { "distDir": ".next" }
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "/v1/$1"
    },
    {
      "src": "/v2/(.*)",
      "dest": "/v2/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/v2/$1"
    }
  ]
}
